# Copy this file to test/.env and fill in real values there. test/.env is
# gitignored - test/.env.example (this file, with no real secrets) is the
# one that gets committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# mysql | pgsql | sqlite (default). sqlite needs nothing else below - it
# writes to test/database/xel.sqlite - so the demo app runs out of the box.
DB_CONNECTION=sqlite

# Only read when DB_CONNECTION is mysql or pgsql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiny_xel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Db driver contract - see src/Database/Contract/DriverContract.php
# ---------------------------------------------------------------------------

# swoole-pool (default, coroutine-native PDOPool) | eloquent (Laravel ORM,
# migrations, model factories - forces the server into blocking mode, see
# src/Database/Driver/EloquentDriver.php for why).
DB_CONTRACT=swoole-pool
