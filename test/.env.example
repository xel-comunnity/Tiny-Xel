# Copy this file to test/.env and fill in real values there. test/.env is
# gitignored - test/.env.example (this file, with no real secrets) is the
# one that gets committed.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

APP_HOST=http://0.0.0.0
APP_PORT=9501

# Worker processes handling requests. With the default "eloquent" db
# contract (enable_coroutine=false, one request at a time per worker - see
# DB_CONTRACT below), this needs to scale with expected concurrent
# requests, the same way PHP-FPM's worker count does - coroutines aren't
# there to make up for a low number here.
APP_WORKER_NUM=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# mysql | pgsql | sqlite (default). sqlite needs nothing else below - it
# writes to test/database/xel.sqlite - so the demo app runs out of the box.
DB_CONNECTION=sqlite

# Only read when DB_CONNECTION is mysql or pgsql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiny_xel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Db driver contract - see src/Database/Contract/DriverContract.php
# ---------------------------------------------------------------------------

# eloquent (default, Laravel ORM/migrations/validation - forces the server
# into blocking mode, see src/Database/Driver/EloquentDriver.php for why) |
# swoole-pool (coroutine-native PDOPool - opt in only if you specifically
# need coroutine concurrency and are prepared to reason about it).
DB_CONTRACT=eloquent
